{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecGuard Report",
  "type": "object",
  "required": [
    "meta",
    "findings"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "tool",
        "version",
        "repo",
        "base",
        "head",
        "timestamp",
        "deterministic",
        "prompt_pack_version"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "deterministic": {
          "type": "boolean"
        },
        "prompt_pack_version": {
          "type": "string"
        },
        "llm_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "cache_hit": {
          "type": "boolean"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "confidence",
          "rule_id",
          "rule_summary",
          "evidence",
          "recommended_action",
          "locations",
          "links"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rule_id": {
            "type": "string"
          },
          "rule_summary": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "recommended_action": {
            "type": "string"
          },
          "impacted_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "start_line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "end_line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "spec",
                    "code",
                    "test",
                    "other"
                  ]
                }
              }
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}